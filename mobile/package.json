{
  "name": "fathom-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ../src/game/testing/resolve.mjs src/testing/run.ts",
    "sync": "npm run build && cap sync ios",
    "ios": "npm run sync && sh scripts/run-ios.sh",
    "ios:autoplay": "VITE_FATHOM_AUTOPLAY=1 vite build --mode simulator && cap sync ios && sh scripts/run-ios.sh",
    "test:dsp": "node scripts/dsp-parity/parity.mjs",
    "test:sound": "node scripts/sound-check/check.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
